{
  "name": "rclgo (ROS 2 Lyrical)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "ROS_DISTRO": "lyrical"
    }
  },
  // Stable container name instead of a randomly generated one.
  "runArgs": ["--name=rclgo-dev"],
  "containerEnv": {
    "GOFLAGS": "-buildvcs=false",
    "RMW_IMPLEMENTATION": "rmw_zenoh_cpp"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-vscode.cpptools",
        "Ranch-Hand-Robotics.rde-ros-2"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "off",
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // Warm the module cache after the container is built. Run `make test` to
  // exercise the full suite against the installed ROS interfaces.
  "postCreateCommand": "go mod download",
  // Run as the image's non-root user, with its UID/GID remapped to the host
  // user's on Linux so files in the bind-mounted workspace keep host ownership.
  "containerUser": "ubuntu",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true
}
